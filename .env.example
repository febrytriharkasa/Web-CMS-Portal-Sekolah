APP_NAME=laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Lokasi mysqldump untuk backup. Kosongkan jika sudah ada di PATH.
# DB_DUMP_BINARY_PATH=/usr/bin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOAD_VIRUS_SCAN=false
VIRUS_SCANNER=clamscan

# Backup harian (spatie/laravel-backup). Kosongkan password = arsip tidak dienkripsi.
BACKUP_NAME=smaliska
BACKUP_NOTIFICATION_EMAIL=
BACKUP_ARCHIVE_PASSWORD=

QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Dibaca halaman admin "Analitik Google". Kosongkan untuk pakai
# storage/app/private/google-service-account.json.
GOOGLE_ANALYTICS_CREDENTIALS=

# Chatbot: driver auto|off. API keys dikosongkan = mode keyword fallback.
CHATBOT_DRIVER=auto
GEMINI_API_KEY=
CHATBOT_GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
CHATBOT_GROQ_MODEL=openai/gpt-oss-120b
CHATBOT_TIMEOUT=15
CHATBOT_MAX_TOKENS=400
CHATBOT_HISTORY_LIMIT=8
CHATBOT_DAILY_LIMIT=300
